# Copy to .env (never commit .env). On Vercel, set these in Project Settings -> Environment Variables.

# Required. Create a key in Google AI Studio.
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call this API (no trailing slash).
# Required in production. In development, leaving it empty allows any origin.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional
PORT=5000
# LOG_LEVEL=debug            # error | warn | info | debug
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
# RATE_LIMIT_MAX=100         # requests per window per IP, all /api routes
# AI_RATE_LIMIT_MAX=30       # requests per window per IP, Gemini-backed routes
# RATE_LIMIT_WINDOW_MS=900000
